{
  "expo": {
    "name": "SM mart Delivery",
    "slug": "sm-mart-delivery-app",
    "scheme": "smmartdelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SM mart uses your location while you are delivering an order.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SM mart shares your location with the customer while an active delivery is in progress."
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.smmart.delivery"
    },
    "android": {
      "package": "com.smmart.delivery",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SM mart Delivery to use your location during an active delivery.",
          "locationAlwaysAndWhenInUsePermission": "Allow SM mart Delivery to share your location during an active delivery.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "kotlinVersion": "2.4.0"
          }
        }
      ]
    ]
  }
}
